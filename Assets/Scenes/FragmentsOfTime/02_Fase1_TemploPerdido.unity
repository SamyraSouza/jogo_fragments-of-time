  m_Script: {fileID: 11500000, guid: e7126eb5d9d34a347a2bc4ccb7adf816, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RiftOfTime.PapyrusPickup
  title: O Papiro da Fenda
  body: "Este templo guarda a m\xE1quina que nossos ancestrais constru\xEDram para selar uma fenda natural no tempo, sob a pir\xE2mide.\n\nSe o selo for rompido, qualquer coisa pode atravessar as eras sem controle.\n\nAs tr\xEAs pe\xE7as do circuito foram escondidas por toda a pir\xE2mide, cada uma vigiada por uma m\xFAmia guardi\xE3. Re\xFAna os fragmentos, reconstrua a m\xE1quina e fa\xE7a a travessia segura de volta."
  qrImage: {fileID: 0}
